# Copy to .env and edit. This file is gitignored.
#
# Everything below is OPTIONAL. Detection, calibration, and the rule-based
# humanizer all work with no configuration and no network access.

# --- Claude rewrite pass (the only feature that sends text off this machine) --
# Both of these are required before any API call is made. Leaving either unset
# keeps the system fully local.
# HUMANIZER_LLM_ENABLED=true
# ANTHROPIC_API_KEY=sk-ant-...

# --- Model choice ------------------------------------------------------------
# Bulk rewriting. claude-haiku-4-5 is ~3x cheaper; claude-opus-5 is the best
# quality and ~2.5x the cost of Sonnet.
# HUMANIZER_BULK_MODEL=claude-sonnet-5
# HUMANIZER_BULK_EFFORT=high

# Used by the --high-quality flag.
# HUMANIZER_QUALITY_MODEL=claude-opus-5

# --- Scoring -----------------------------------------------------------------
# Stop rewriting once the document scores below this.
# HUMANIZER_TARGET_SCORE=20

# Meaning guards. Raising these rejects more rewrites but protects meaning more
# strictly.
# HUMANIZER_MIN_SENTENCE_SIMILARITY=0.88
# HUMANIZER_MIN_DOCUMENT_SIMILARITY=0.93

# --- Local models ------------------------------------------------------------
# HUMANIZER_DEVICE=auto           # auto | mps | cuda | cpu
